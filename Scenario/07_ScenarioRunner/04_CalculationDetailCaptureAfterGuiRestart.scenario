# CalculationDetailCaptureAfterGuiRestart.scenario
#
# 同一Scenario内でGui.exeを終了・再起動しても、
# CAPTURE CALC DETAILで取得した計算結果詳細が
# ScenarioExecutonContextに保持されることを確認する。
#
# 再起動後に同じ式神と御魂セットで再計算し、
# 御魂のみのステータス詳細と最終ステータス詳細が
# 再起動前の文字列と完全一致することを確認する。

START

# 1回目のGui.exeを起動し、計算条件を設定する
OPEN GUI
SEL SHIKIGAMI "願紡縁結神"
LOAD MITAMA "../02_Calculation/TestData/Valid.mitama.json"

CALC
CHECK CALC

# 再起動前の計算結果詳細を保存する
OPEN CALC DETAIL
CHECK CALC DETAIL
CAPTURE CALC DETAIL
CLOSE CALC DETAIL

# GuiSessionを破棄する
CLOSE GUI

# 新しいGuiSessionでGui.exeを再起動する
OPEN GUI
SEL SHIKIGAMI "願紡縁結神"
LOAD MITAMA "../02_Calculation/TestData/Valid.mitama.json"

CALC
CHECK CALC

# Scenario内に保持された再起動前の詳細と比較する
OPEN CALC DETAIL
CHECK CALC DETAIL UNCHANGED
CLOSE CALC DETAIL

CLOSE GUI

END
