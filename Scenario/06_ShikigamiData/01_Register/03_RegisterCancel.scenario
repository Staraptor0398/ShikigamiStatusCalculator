# RegisterCancel.scenario
#
# Gui.exeの式神登録画面を開いてキャンセルした場合、
# MainFormの入力状態と式神候補一覧が
# 変更されないことを確認する。
#
# キャンセル後も既存の式神選択が維持され、
# 式神データが引き続き利用可能であることを確認する。

START

# Gui.exeを起動する
OPEN GUI

# 既存の式神を選択する
SEL SHIKIGAMI "願紡縁結神"

# キャンセル前の入力状態を保持する
CAPTURE INPUT

# キャンセル前の式神候補一覧を確認する
CHECK SHIKIGAMI LIST "すべて"

# 式神登録画面を開く
OPEN SHIKIGAMI REGISTER

# 登録処理を実行せずにキャンセルする
CANCEL DIALOG

# キャンセル前後の入力状態が完全一致することを確認する
CHECK INPUT UNCHANGED

# 選択中の式神が維持されていることを確認する
CHECK SHIKIGAMI SELECTION "願紡縁結神"

# 式神候補一覧が正常であることを確認する
CHECK SHIKIGAMI LIST "すべて"

# Gui.exeを終了する
CLOSE GUI

END
