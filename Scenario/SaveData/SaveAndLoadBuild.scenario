# SaveAndLoadBuild.scenario
#
# 式神と御魂をGui.exeのビルド保存機能で保存した後、
# 入力内容をCLEARし、同一Scenario内で保存したビルドを
# 再読み込みできることを確認する。
#
# 保存前と再読み込み後の計算結果をSnapshotとして保存し、
# 全ステータスの差分が0であることを確認することで、
# 式神と御魂の両方が保存前と同等に復元されることを確認する。

START

OPEN GUI

# 対象式神を選択
SEL SHIKIGAMI "願紡縁結神"

# 正常な御魂セットを読み込む
LOAD MITAMA "../Calculation/TestData/Valid.mitama.json"

# 保存前の計算結果を作成する
CALC
CHECK CALC

# 保存前の状態を比較元Snapshotとして保存する
SAVE SNAPSHOT BASE

# Gui.exeの保存機能でビルドを保存する
SAVE BUILD

# 入力内容を初期化する
CLEAR
CHECK CLEARED

# 同一Scenario内で保存したビルドを再読み込みする
LOAD SAVED BUILD

# Build保存データには式神も含まれるため、
# ここでは式神を再選択せず、復元された状態のまま計算する
CALC
CHECK CALC

# 再読み込み後の状態を比較先Snapshotとして保存する
# 式神が正しく復元されていない場合は、
# 正常な計算結果Snapshotとして保存できないため、この時点でも検出できる
SAVE SNAPSHOT TARGET

# 保存前と再読み込み後の計算結果を比較する
COMPARE SAVED SNAPSHOT

# 式神と御魂が保存前と同等に復元されていることを、
# 全ステータスの差分が0であることによって確認する
CHECK SNAPSHOT COMPARISON "攻撃力" "0"
CHECK SNAPSHOT COMPARISON "HP" "0"
CHECK SNAPSHOT COMPARISON "防御力" "0"
CHECK SNAPSHOT COMPARISON "素早さ" "0"
CHECK SNAPSHOT COMPARISON "会心率" "0"
CHECK SNAPSHOT COMPARISON "会心DMG" "0"
CHECK SNAPSHOT COMPARISON "効果命中" "0"
CHECK SNAPSHOT COMPARISON "効果抵抗" "0"

# 比較結果画面を閉じる
CLOSE DIALOG

CLOSE GUI

END
