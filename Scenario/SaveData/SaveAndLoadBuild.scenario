# SaveAndLoadBuild.scenario
#
# 式神と御魂をGui.exeのビルド保存機能で保存した後、
# 入力内容をCLEARし、同一Scenario内で保存したビルドを
# 再読み込みできることを確認する。
#
# SAVE BUILDによって保存された式神および御魂入力が
# LOAD SAVED BUILDによってGui上へ正しく復元され、
# 再読み込み後も正常に計算できることを確認する。

START

OPEN GUI

# 対象式神を選択
SEL SHIKIGAMI "願紡縁結神"

# 正常な御魂セットを読み込む
LOAD MITAMA "../Calculation/TestData/Valid.mitama.json"

# Gui.exeの保存機能でビルドを保存する
SAVE BUILD

# 入力内容を初期化する
CLEAR
CHECK CLEARED

# 同一Scenario内で保存したビルドを再読み込みする
LOAD SAVED BUILD

# 復元された式神と御魂の状態で正常に計算できることを確認する
CALC
CHECK CALC

CLOSE GUI

END
