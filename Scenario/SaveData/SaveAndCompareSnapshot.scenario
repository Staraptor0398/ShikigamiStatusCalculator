# SaveAndCompareSnapshot.scenario
#
# Gui.exeで計算した結果からBASE / TARGETのSnapshotを保存し、
# 同一Scenario内で生成した2つのSnapshotを比較できることを確認する。
#
# BASEとTARGETは同一の計算結果から保存するため、
# 比較結果の差分が0になることを確認する。

START

OPEN GUI

# 対象式神を選択
SEL SHIKIGAMI "願紡縁結神"

# 正常な御魂セットを読み込む
LOAD MITAMA "../Calculation/TestData/Valid.mitama.json"

# Snapshot保存可能な計算済み状態を作成する
CALC
CHECK CALC

# 同一の計算結果を比較元・比較先としてそれぞれ保存する
SAVE SNAPSHOT BASE
SAVE SNAPSHOT TARGET

# 同一Scenario内で保存した2つのSnapshotを比較する
COMPARE SAVED SNAPSHOT

# 同一結果同士なので差分が0であることを確認する
CHECK SNAPSHOT COMPARISON "会心DMG" "0"

# 比較結果画面を閉じる
CLOSE DIALOG

CLOSE GUI

END

