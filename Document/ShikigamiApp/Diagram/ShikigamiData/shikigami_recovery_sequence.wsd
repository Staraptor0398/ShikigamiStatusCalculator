@startuml
title ShikigamiApp 式神データ復旧 シーケンス

hide footbox
skinparam shadowing false
skinparam sequenceMessageAlign center

actor "ユーザー" as User
participant "MainForm" as MainForm
box "Gui"
    participant "OpenFileDialog" as FileDialog
    participant "ShikigamiRecoveryDialog" as RecoveryDialog
    participant "ShikigamiDataFileManager" as FileManager
    participant "ShikigamiDataErrorHandler" as ErrorHandler
end box
box "Gateway"
    participant "ShikigamiGateway" as Gateway
end box
box "Core"
    participant "ShikigamiService" as Service
    participant "ShikigamiRepository" as Repository
    participant "FileAccess" as FileAccess
end box
database "ShikigamiData.csv" as CurrentData
database "選択された復旧元CSV\n（Backup / Brokenなど）" as SourceData
database "Data/Backup" as Backup

== 復旧元の選択 ==
User -> MainForm : 式神データ復旧ボタン押下
MainForm -> FileDialog : ShowDialog(this)
alt キャンセル
    FileDialog --> MainForm : Cancel
    MainForm --> User : 終了
else CSVを選択
    FileDialog --> MainForm : FileName

    == 復旧候補取得 ==
    MainForm -> Gateway : GetRecoveryCandidateShikigamiList(currentPath, sourcePath, out list)
    Gateway -> Service : 復旧候補取得
    Service -> Repository : getRecoveryCandidateShikigamiList(currentPath, sourcePath, out list)
    Repository -> FileAccess : loadShikigami(currentPath)
    FileAccess -> CurrentData : 読込
    CurrentData --> FileAccess : CSV
    FileAccess --> Repository : 現行式神一覧 / Outcome
    Repository -> FileAccess : loadValidShikigami(sourcePath)
    FileAccess -> SourceData : 有効な行を読込
    SourceData --> FileAccess : CSV
    FileAccess --> Repository : 復旧元式神一覧 / Outcome
    Repository -> Repository : mRecoverySourceFilePath = sourcePath
    Repository -> Repository : extractUnknownShikigamiList(current, source)
    Repository --> Service : 復旧候補 / Outcome
    Service --> Gateway : 復旧候補 / Outcome
    Gateway --> MainForm : DTO一覧 / Outcome

    alt 候補取得失敗・例外
        MainForm -> ErrorHandler : Handle(outcome / exception)
        ErrorHandler --> User : エラー表示
    else 候補が0件
        MainForm --> User : 復旧できる式神なし
    else 候補あり
        MainForm -> RecoveryDialog : new(recoveryCandidates)
        MainForm -> RecoveryDialog : ShowDialog(this)
        RecoveryDialog --> User : 復旧候補一覧を表示
        User -> RecoveryDialog : 復旧対象を選択 / 実行

        alt キャンセル
            RecoveryDialog --> MainForm : Cancel
        else OK
            RecoveryDialog --> MainForm : SelectedRecoveryCandidates

            == 復旧実行 ==
            MainForm -> FileManager : CreateBackup()
            FileManager -> Backup : 現行CSVをバックアップ
            MainForm -> Gateway : RecoveryShikigami(currentPath, selected)
            Gateway -> Service : 復旧要求
            Service -> Repository : recoverShikigamiList(currentPath, selected)
            Repository -> FileAccess : loadShikigami(currentPath)
            FileAccess -> CurrentData : 読込
            CurrentData --> FileAccess : CSV
            FileAccess --> Repository : 現行式神一覧 / Outcome
            Repository -> FileAccess : loadValidShikigami(mRecoverySourceFilePath)
            FileAccess -> SourceData : 再読込
            SourceData --> FileAccess : CSV
            FileAccess --> Repository : 復旧元式神一覧 / Outcome
            Repository -> Repository : extractUnknownShikigamiList(current, selected)

            alt 追加対象が0件
                Repository --> Service : SUCCESS（保存なし）
            else 追加対象あり
                Repository -> Repository : mergeShikigamiList(current, source, targets)
                note right of Repository
                    復旧元の並びを基準に、前後の共通式神を
                    アンカーとして挿入位置を決める。
                    共通式神がない場合はレア度順に挿入する。
                end note
                Repository -> FileAccess : saveShikigami(currentPath, merged)
                FileAccess -> CurrentData : CSV保存
                CurrentData --> FileAccess : 完了
                FileAccess --> Repository : Outcome
                opt 保存成功
                    Repository -> Repository : mRecoverySourceFilePath.clear()
                end
                Repository --> Service : Outcome
            end
            Service --> Gateway : Outcome
            Gateway --> MainForm : Outcome

            alt 復旧失敗・例外
                MainForm -> ErrorHandler : Handle(outcome / exception)
                ErrorHandler --> User : エラー表示
            else SUCCESS
                MainForm --> User : 復旧成功を表示
                MainForm -> MainForm : initializeShikigamiComboBox()
                MainForm -> MainForm : markCalculationResultDirty()
            end
        end
    end
end

@enduml
