@startuml
title CREATE SHIKIGAMI BACKUP - コマンド相互作用図
skinparam responseMessageBelowArrow true
' Source: ScenarioRunner.Engine/Execution/ScenarioCommandExecutor.cs
' Source: ScenarioRunner.Engine/Automation/Operator/Feature/ShikigamiDataOperator.cs
participant "ScenarioCommandExecutor" as EX
participant "ShikigamiDataOperator" as O
participant "ShikigamiOperator" as SO
participant "GuiOperator" as GO
participant "ComboBoxOperator" as CO
participant "ShikigamiEditOperator" as EO
participant "GuiOperator" as GO
participant "ButtonOperator" as BO
participant "ShikigamiEditOperator" as EO
participant "ProcessWindowWaiter" as PW
participant "ButtonOperator" as BO
participant "WindowWaiter" as WW
participant "Application / GuiSession" as APP

EX -> O : CreateBackup(session)
activate O
O -> SO : SelectFirst(session)
O -> GO : GetMainElement(SHIKIGAMI, ComboBox)
O -> CO : SelectFirstItem(element)
O -> EO : Open(session)
O -> GO : GetMainElement(EDIT_SHIKIGAMI, Button)
O -> BO : PostClick(button)
O -> EO : Save(session)
O -> PW : WaitForProcessWindow(ShikigamiRegisterForm)
O -> BO : Click(REGISTER button)
O -> WW : WaitForWindowClosed(editForm)
O -> APP : WaitWhileBusy(5s)
O --> EX : 処理完了（失敗時は例外）
deactivate O
@enduml
