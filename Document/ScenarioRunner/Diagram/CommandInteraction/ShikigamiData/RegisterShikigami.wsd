@startuml
title REGISTER SHIKIGAMI - コマンド相互作用図
skinparam responseMessageBelowArrow true
' Source: ScenarioRunner.Engine/Execution/ScenarioCommandExecutor.cs
' Source: ScenarioRunner.Engine/Automation/Operator/Feature/ShikigamiRegisterOperator.cs
participant "ScenarioCommandExecutor" as EX
participant "ShikigamiRegisterOperator" as O
participant "GuiOperator" as GO
participant "ProcessWindowWaiter" as PW
participant "ComboBoxOperator" as CO
participant "TextBoxOperator" as TO
participant "ButtonOperator" as BO
participant "ShikigamiRegisterForm" as GUI

EX -> O : Register(context, filePath)
activate O
O -> O : context.ResolvePath(filePath)
O -> O : JSONを読み込み、必須項目を検証
O -> GO : GetMainWindow(session)
O -> PW : WaitForProcessWindow(ShikigamiRegisterForm)
O -> O : 登録フォームのAutomationElementMapを生成
alt Rarity is empty
O -> CO : ClearSelection(rarity)
else レアリティが指定されている
O -> CO : SelectItem(rarity)
end
loop Name and eight numeric/stat fields
O -> TO : SetText(form field, inputData value)
end
O -> BO : PostClick(REGISTER button)
O -> GUI : 登録イベント処理
O --> EX : 処理完了（失敗時は例外）
deactivate O
@enduml
