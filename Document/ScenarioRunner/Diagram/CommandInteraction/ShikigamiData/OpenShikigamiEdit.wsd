@startuml
title OPEN SHIKIGAMI EDIT - コマンド相互作用図
skinparam responseMessageBelowArrow true
' Source: ScenarioRunner.Engine/Execution/ScenarioCommandExecutor.cs
' Source: ScenarioRunner.Engine/Automation/Operator/Feature/ShikigamiEditOperator.cs
participant "ScenarioCommandExecutor" as EX
participant "ShikigamiEditOperator" as O
participant "GuiOperator" as GO
participant "ButtonOperator" as BO
participant "ShikigamiRegisterForm" as GUI

EX -> O : Open(session)
activate O
O -> O : resetEditFormCache()
O -> GO : GetMainElement(EDIT_SHIKIGAMI, Button)
O -> BO : PostClick(button)
O -> GUI : ShikigamiRegisterFormを編集モードで開く
O --> EX : 処理完了（失敗時は例外）
deactivate O
@enduml
