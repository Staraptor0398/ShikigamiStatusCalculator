@startuml
title OPEN SHIKIGAMI REGISTER - コマンド相互作用図
skinparam responseMessageBelowArrow true
' Source: ScenarioRunner.Engine/Execution/ScenarioCommandExecutor.cs
' Source: ScenarioRunner.Engine/Automation/Operator/Feature/ShikigamiRegisterOperator.cs
participant "ScenarioCommandExecutor" as EX
participant "ShikigamiRegisterOperator" as O
participant "GuiOperator" as GO
participant "ButtonOperator" as BO
participant "MainForm" as GUI

EX -> O : Open(session)
activate O
O -> GO : GetMainElement(REGISTER_SHIKIGAMI, Button)
O -> BO : PostClick(button)
O -> GUI : ShikigamiRegisterFormを開く
O --> EX : 処理完了（失敗時は例外）
deactivate O
@enduml
