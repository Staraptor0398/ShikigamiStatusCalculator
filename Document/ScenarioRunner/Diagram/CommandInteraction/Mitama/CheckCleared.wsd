@startuml
title CHECK CLEARED - コマンド相互作用図
skinparam responseMessageBelowArrow true
' Source: ScenarioRunner.Engine/Execution/ScenarioCommandExecutor.cs
' Source: ScenarioRunner.Engine/Automation/Operator/Feature/InputOperator.cs
participant "ScenarioCommandExecutor" as EX
participant "InputOperator" as O
participant "GuiOperator" as GO
participant "ComboBoxOperator" as CO
participant "TextBoxOperator" as TO

EX -> O : CheckCleared(session)
activate O
O -> GO : GetMainElementMap(session)
loop SHIKIGAMI, main/sub stat, set and unique ComboBoxes
O -> CO : GetValue(element)
O -> O : 値が空であることを確認
end
loop BASE_STATS, main/sub values, MITAMA_ONLY, FINAL_STATS
O -> TO : GetText(element)
O -> O : テキストが空であることを確認
end
O --> EX : 処理完了（失敗時は例外）
deactivate O
@enduml
