@startuml
title CLEAR - コマンド相互作用図
skinparam responseMessageBelowArrow true
' Source: ScenarioRunner.Engine/Execution/ScenarioCommandExecutor.cs
' Source: ScenarioRunner.Engine/Automation/Operator/Feature/InputOperator.cs
participant "ScenarioCommandExecutor" as EX
participant "InputOperator" as O
participant "GuiOperator" as GO
participant "ButtonOperator" as BO
participant "MainForm" as GUI
participant "DialogOperator" as DO
participant "ButtonOperator" as BO
participant "Application / GuiSession" as APP

EX -> O : Clear(session)
activate O
O -> GO : GetMainElement(CLEAR, Button)
O -> BO : PostClick(clearButton)
O -> GUI : クリア確認MessageBoxを表示
O -> DO : GetActiveDialog(session)
O -> BO : Click(dialog, YES)
O -> APP : WaitWhileBusy(5s)
O --> EX : 処理完了（失敗時は例外）
deactivate O
@enduml
