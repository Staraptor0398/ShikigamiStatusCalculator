@startuml
title LOAD SAVED BUILD - コマンド相互作用図
skinparam responseMessageBelowArrow true
' Source: ScenarioRunner.Engine/Execution/ScenarioCommandExecutor.cs
' Source: ScenarioRunner.Engine/Automation/Operator/Feature/SaveDataOperator.cs
participant "ScenarioCommandExecutor" as EX
participant "SaveDataOperator" as O
participant "GuiOperator" as GO
participant "ButtonOperator" as BO
participant "ProcessWindowWaiter" as PW
participant "ComboBoxOperator" as CO
participant "FileDialogWaiter" as FDW
participant "FileDialogOperator" as FDO
participant "WindowWaiter" as WW

EX -> O : LoadSavedBuild(context)
activate O
O -> O : validateSavedFilePath(context.SavedBuildFilePath)
O -> O : load(context, BUILD_SAVE_TYPE, savedPath)
O -> O : 実行コンテキストと読込元ファイルを検証
O -> GO : GetMainElement(LOAD, Button)
O -> BO : PostClick(mainLoadButton)
O -> PW : WaitForProcessWindow(SaveDataLoadDialog)
O -> O : 読込ダイアログの子要素からAutomationElementMapを生成
O -> CO : SelectItem(LOAD_TYPE, loadType)
O -> BO : PostClick(BROWSE)
O -> FDW : WaitForFileDialog(session, loadDialog)
O -> FDO : SelectLoadFile(fileDialogElements, filePath)
O -> BO : PostClick(LOAD)
O -> WW : WaitForWindowClosed(loadDialog)
O -> O : waitForLoadCompleted(): 無効→有効、または有効状態の連続確認で完了判定
O --> EX : 処理完了（失敗時は例外）
deactivate O
@enduml
