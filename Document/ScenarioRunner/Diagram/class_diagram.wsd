
@startuml

title ShikigamiApp Scenario Runner - Class Diagram

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam packageStyle rectangle
hide empty members

top to bottom direction

package "Form" {
    class MainForm
}

package "ScenarioFormat" {
    class ScenarioLoader
    class ScenarioCompiler
    class ScenarioParser
    class ScenarioValidator

    class Scenario {
        + string FilePath
        + IReadOnlyList<ScenarioStep> Steps
    }

    class ScenarioStep {
        + int LineNumber
        + ScenarioCommandType CommandType
        + IReadOnlyList<string> Arguments
    }

    enum ScenarioCommandType
}

package "Execution" {
    class ScenarioExecutor
    class ScenarioCommandExecutor

    class ScenarioExecutonContext {
        + string ScenarioPath
        + string GuiExecutablePath
        + GuiSession GuiSession
        + CancellationToken CancellationToken
    }

    class ScenarioExecutionOptions {
        + bool WatchMode
        + bool CleanupGuiOnExit
    }

    class ScenarioExecutionResult {
        + bool IsSuccess
        + bool IsStopped
        + int PassedCount
        + int FailedCount
        + TimeSpan Elapsed
    }
}

package "Automation" {
    class GuiSession
}

package "Log" {
    class ScenarioLogger
    class LogFileWriter
}

' ========================================
' Scenario loading
' ========================================
ScenarioLoader --> ScenarioCompiler
ScenarioCompiler --> ScenarioParser
ScenarioCompiler --> ScenarioValidator

ScenarioParser ..> Scenario : creates

Scenario "1" *-- "0..*" ScenarioStep
ScenarioStep --> ScenarioCommandType

' ========================================
' Scenario execution
' ========================================
ScenarioExecutor --> ScenarioCommandExecutor
ScenarioExecutor ..> ScenarioExecutonContext : creates
ScenarioExecutor ..> ScenarioExecutionResult : creates

ScenarioExecutonContext --> ScenarioExecutionOptions
ScenarioExecutonContext --> GuiSession

' ========================================
' Form / Log
' ========================================
MainForm --> ScenarioLoader
MainForm --> ScenarioExecutor
MainForm --> ScenarioLogger

ScenarioExecutor --> ScenarioLogger
ScenarioLogger --> LogFileWriter

note right of ScenarioCommandExecutor
ScenarioCommandType に応じて
Automation 層の Operator に処理を委譲する。

詳細は Automation Class Diagram を参照。
end note

@enduml
